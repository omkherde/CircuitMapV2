# REQUIRED — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — adjust paths if needed
AHBA_DATA_DIR=./cache/ahba_data
CHROMA_DB_DIR=./cache/chroma_db
NEUROSYNTH_DATA_DIR=./cache/neurosynth_data
DEMO_CACHE_DIR=./cache/demo
SESSIONS_DIR=./sessions

# OPTIONAL — server config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OPTIONAL — live UI config (frontend reads from /api/config)
APP_DISPLAY_NAME=CircuitMap
APP_TAGLINE=AI-Powered Drug Target Validation
SYSTEM_STATUS_LABEL=System Online
INPUT_PANEL_TITLE=Input
DRUG_QUERY_LABEL=Drug Molecule
DRUG_NAME_PLACEHOLDER=Enter drug name...
SMILES_PLACEHOLDER=Enter SMILES string...
QUERY_TYPE_NAME_LABEL=Drug name
QUERY_TYPE_SMILES_LABEL=SMILES
INDICATION_LABEL=Disease Indication
INDICATION_PLACEHOLDER=Select indication...
VALIDATE_BUTTON_LABEL=Validate Target
VALIDATING_BUTTON_LABEL=Validating...
LOAD_DEMO_BUTTON_LABEL=Load Demo
LIVE_DISEASE_INDICATIONS=Alzheimer's disease|Parkinson's disease|Schizophrenia|Major depressive disorder|Bipolar disorder|PTSD|Epilepsy|ALS|Huntington's disease|Treatment-resistant depression|Anxiety disorders|Frontotemporal dementia
CONFIDENCE_PANEL_TITLE=Confidence
CONFIDENCE_EMPTY_STATE=Awaiting confidence assessment...
CONFIDENCE_LABEL_TARGET_RESOLUTION=Target Resolution
CONFIDENCE_LABEL_CIRCUIT_ALIGNMENT=Circuit Alignment
CONFIDENCE_LABEL_LITERATURE_SUPPORT=Literature Support

# OPTIONAL — agent behavior
MAX_TOOL_CALLS=5
SESSION_TIMEOUT_SECONDS=300
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_MAX_API_RETRIES=1
CLAUDE_RATE_LIMIT_BACKOFF_SECONDS=70
TARGET_RESOLUTION_TIMEOUT_SECONDS=6

# OPTIONAL — RAG config
RAG_TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
